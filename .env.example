# ExamForge environment variables (copy to .env.local and fill in)

# Desmos Graphing Calculator API key (free from https://www.desmos.com/api/)
# Without this the in-app calculator falls back to a link to desmos.com/calculator
NEXT_PUBLIC_DESMOS_API_KEY=

# ---------------------------------------------------------------------------
# Optional: live AI tutor. Leave blank to use the fully-offline local stub.
# The key is read SERVER-SIDE ONLY and is never exposed to the browser.
#
# RECOMMENDED (free, no billing, no credit card): Google Gemini.
#   1. Sign in with your Google account at https://aistudio.google.com/app/apikey
#   2. Click "Get API key" and copy it.
#   3. Set the two lines below, then restart `npm run dev`.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional override (default: gemini-2.0-flash). Other free options: gemini-1.5-flash
AI_MODEL=

# ---------------------------------------------------------------------------
# Alternative: OpenAI (paid, pay-per-use, separate from a ChatGPT subscription).
#   Set AI_PROVIDER=openai and provide an sk-... key from platform.openai.com.
# OPENAI_API_KEY=
#
# Generic fallback key (used when no provider-specific key is set):
# AI_API_KEY=
